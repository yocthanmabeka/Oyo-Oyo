// A button, a point, and a rule of the world that links the two.
// The button holds no code: the rule asks for the capability.
Page(
  title: "My shop",
  children: [
    Button(name: Open, text: "Open the workshop"),
    Point(
      name: Workshop,
      seed: 42,
      inside: World(children: [ "## The workshop" ]),
    ),
  ],
  rules: [
    On(Open.tap, effect: Workshop.enter),
  ],
)
