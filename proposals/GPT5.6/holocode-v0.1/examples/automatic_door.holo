// Première preuve exécutable du noyau holoscénique.
world Building {
    entity User {
        position: (0m, 0m, 0m)
    }

    entity Door {
        position: (0m, 0m, 1m)
        opened: false
        locked: false
    }

    relation Near(User, Door) {
        distance < 2m
    }

    phenomenon AutomaticOpening {
        when Near active and Door.locked == false
        effect Door.opened = true
    }
}

