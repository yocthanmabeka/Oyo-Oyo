Page(title: "x", state: State(chosen: "", cart: [ Item(title: "", price: 0) ], articles: [ Item(title: "Lever", price: 100), Item(title: "Barque", price: 200) ]), children: [ H1("x"), P("{cart} au panier"), Repeat(over: cart, children: [ Text("{item.title} : {item.price:cents}") ]), Repeat(over: articles, children: [ Button(name: Pick, text: "{item.title}") ], rules: [ On(Pick.tap, effect: [chosen.set(item), cart.push(Item(title: chosen, price: 0))]) ]) ])
