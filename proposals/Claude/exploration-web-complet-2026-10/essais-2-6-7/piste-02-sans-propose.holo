Page(
  title: "Réserver — L'atelier des mondes",
  lang: "fr",
  state: State(lever: 2, porte: 1, name: "", mail: "", delivery: "", address: "", gift: 0, sent: 0, failed: 0),
  prices: Prices(lever: 120, porte: 90),
  children: [
    H1("Réserver vos tableaux"),
    P("{count} tableaux, {total} euros."),
    Form(name: Booking, children: [                                       
      Input(value: name, label: "Votre nom"),                      
      Input(value: mail, label: "Votre courriel"),   
      Choice(value: delivery, label: "Livraison", options: ["À domicile", "À l'atelier"]),     
      If(delivery, not: "", children: [                                                    
        Input(value: address, label: "Adresse de livraison", lines: 3),   
      ]),
      Checkbox(value: gift, label: "Emballage cadeau"),
      Button(name: Send, text: "Réserver"),
    ]),
    If(sent, is: 1, children: [ P("Merci, votre réservation est arrivée.") ]),        
    If(failed, is: 1, children: [ P("La réservation n'est pas partie : réessayez.") ]),    
  ],
  rules: [
    On(Send.tap, effect: [failed.set(0), Booking.send]),
    On(Booking.sent, effect: sent.set(1)),
    On(Booking.failed, effect: failed.set(1)),
  ],
)
