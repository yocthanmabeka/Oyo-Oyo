Page(
  title: "Catalogue",
  state: State(ici: 2),
  components: [
    Component(name: Menu, params: [current], children: [
      Nav(children: [ Row(children: [
        If(current, is: 1, children: [ Text.courant("Accueil") ], else: [ A("Accueil", to: "accueil.holo") ]),
        If(current, is: 2, children: [ Text.courant("Catalogue") ], else: [ A("Catalogue", to: "catalogue.holo") ]),
      ]) ]),
    ]),
  ],
  children: [ Menu(current: ici), H1("Catalogue") ],
)

.courant { font-weight: bold; }
