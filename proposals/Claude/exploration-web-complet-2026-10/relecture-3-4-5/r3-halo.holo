Page(title: "Halo", children: [ Row(gap: 12px, children: [ Button.action(name: Un, text: "Ajouter"), Button.action(name: Deux, text: "Retirer") ]) ])

.action { background: #8a3b12; color: #fffaf3; border-radius: 999px; padding: 10px 22px; focus: { box-shadow: 0 0 0 #2a2118, 3px 3px 0 #2a2118, -3px -3px 0 #2a2118; } }
