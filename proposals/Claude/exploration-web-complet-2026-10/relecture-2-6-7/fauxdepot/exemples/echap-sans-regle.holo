Page(
  title: "Échap et fenêtre, sans règle",
  state: State(n: 0),
  children: [
    H1("Échap et fenêtre, sans règle"),
    Button(name: Ouvrir, text: "Ouvrir"),
    Dialog(name: Fenetre, children: [ H2("Une fenêtre"), P("Échap la ferme.") ]),
  ],
  rules: [
    On(Ouvrir.tap, effect: Fenetre.open),
  ],
)
