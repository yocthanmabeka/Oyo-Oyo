// Leçon 131 — Des filtres d'image
//
// Ce qu'on apprend :
//   Dans un style, six réglages changent l'image d'une photo, d'une forme ou d'un dessin :
//     grayscale: 1;       tout gris (0 : les couleurs)
//     saturate: 1.8;      des couleurs plus vives (0 : gris ; 1 : rien ne change ; jusqu'à 3)
//     brightness: 0.6;    plus sombre (1 : rien ne change ; plus : plus clair ; de 0.2 à 3)
//     contrast: 1.2;      plus contrasté (1 : rien ne change ; de 0.2 à 3)
//     hue: 30deg;         les couleurs tournent sur le cercle des teintes, comme dans Enter
//     blur: 3px;          flou, de 0 à 100px
//   Chaque réglage est à part : hover: { grayscale: 0; } rend les couleurs et garde le reste.
//   backdrop-blur: 6px;   sur une fenêtre (Dialog) : la page, derrière elle, devient floue.
//   Un filtre ne touche jamais un texte, qui se lirait mal, ni une vidéo (ses commandes, ses
//   sous-titres) : les couleurs d'un texte se changent par color et background.
//   Au clavier, une forme filtrée qu'on touche se montre sans filtre quand elle a le focus :
//   son cadre de focus reste net.
//
// À essayer :
//   Passe la souris sur la première image (au doigt : garde-le dessus) : elle reprend ses
//   couleurs. Touche « Ouvrir la fenêtre » : la page, derrière, devient floue.
//   Écris blur: 3px; dans le style de H1 : le moteur refuse, un texte flou ne se lit pas.
//
// (Les styles tout en bas servent à rendre la leçon lisible : voir la leçon 5.)

Page(
  title: "Leçon 131 : des filtres d'image",
  children: [
    H1("Des filtres d'image"),
    P("Le même lac, quatre fois : en gris, assombri, plus vif, flou."),
    Row(gap: 16px, children: [
      Image.gris(source: "paysage.svg", alt: "Le lac au matin, en gris ; en couleurs au survol"),
      Image.sombre(source: "paysage.svg", alt: "Le lac au matin, assombri"),
      Image.vive(source: "paysage.svg", alt: "Le lac au matin, aux couleurs plus vives"),
      Image.floue(source: "paysage.svg", alt: "Le lac au matin, flou"),
    ]),
    P("Assombrie, une photo laisse lire le titre posé sur elle :"),
    Stack(children: [
      Image.fond(source: "paysage.svg", alt: ""),
      H2.bandeau("Le lac, au matin"),
    ]),
    Button(name: Ouvrir, text: "Ouvrir la fenêtre"),
    Dialog(name: Fenetre, children: [
      H2("Une fenêtre"),
      P("Derrière, la page est floue."),
      Button(name: Fermer, text: "Fermer"),
    ]),

    Hr(),
    Row(gap: 16px, align: between, children: [
      A("← Leçon 130 : partager la page", to: "130-partager-la-page.holo"),
      A("Leçon 132 : des heures →", to: "132-des-heures.holo"),
    ]),
  ],
  rules: [
    On(Ouvrir.tap, effect: Fenetre.open),
    On(Fermer.tap, effect: Fenetre.close),
  ],
)

Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 28px; }
A { color: #8fd3ff; }
Image { width: 140px; border-radius: 8px; }
.gris { grayscale: 1; transition: 0.4s; hover: { grayscale: 0; } active: { grayscale: 0; } }
.sombre { brightness: 0.6; contrast: 1.2; }
.vive { saturate: 1.8; hue: 30deg; }
.floue { blur: 3px; }
.fond { width: 100%; brightness: 0.5; }
.bandeau { font-size: 24px; text-shadow: 0 2px 8px #000000AA; }
Dialog { backdrop-blur: 6px; background: #1a1a2e; color: white; }
