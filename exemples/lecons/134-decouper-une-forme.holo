// Leçon 134 — Découper une forme
//
// Ce qu'on apprend :
//   Dans un style, « form » découpe une image ou un dessin en une forme nommée :
//     form: circle;     un rond (un ovale si le bloc est plus large que haut :
//                       aspect-ratio: 1 en fait un rond)
//     form: hexagon;    un hexagone, une pointe à gauche et une à droite
//     form: star;       une étoile à cinq branches
//     form: heart;      un cœur
//     form: wave;       le bas du bloc ondule, en deux vagues
//     form: triangle;   form: diamond; (un losange)   form: square; (rien n'est découpé)
//   Ce sont les mots de Shape(form:), qui prend aussi les huit formes.
//   La forme suit la taille du bloc. Pas de tracé écrit à la main.
//   Une forme découpe une image ou un dessin, jamais un texte, qui se lirait mal.
//   Au clavier, rien ne disparaît : une forme qu'on touche garde son cadre de focus autour
//   d'elle, et une image découpée qui a le focus se montre entière, avec son cadre.
//
// À essayer :
//   Touche l'étoile : au doigt, à la souris, ou avec Tab puis Entrée.
//   Passe sur l'hexagone (la souris, le doigt, ou Tab) : une phrase apparaît.
//   Écris form: star; dans le style de H1 : le moteur refuse, un texte découpé ne se lit pas.
//
// (Les styles tout en bas servent à rendre la leçon lisible : voir la leçon 5.)

Page(
  title: "Leçon 134 : découper une forme",

  state: State(touches: 0, vue: 0),

  children: [
    H1("Découper une forme"),
    Stack(children: [
      Image.vague(source: "paysage.svg", alt: ""),
      H2.bandeau("Le lac, au matin"),
    ]),
    P("La même photo, découpée de quatre façons :"),
    Row(gap: 16px, children: [
      Image.rond(source: "paysage.svg", alt: "Le lac au matin, dans un rond"),
      Image.ruche(name: Ruche, source: "paysage.svg", alt: "Le lac au matin, dans un hexagone"),
      Image.etoile(source: "paysage.svg", alt: "Le lac au matin, dans une étoile"),
      Image.coeur(source: "paysage.svg", alt: "Le lac au matin, dans un cœur"),
    ]),
    If(vue, is: 1, children: [ P("Six côtés, comme une alvéole de ruche.") ]),

    P("Les huit formes de Shape :"),
    Row(gap: 16px, children: [
      Shape(form: circle, color: "#E9B44C", size: 40px),
      Shape(form: square, color: "#8fd3ff", size: 40px),
      Shape(form: triangle, color: "#3FA34D", size: 40px),
      Shape(form: diamond, color: "#FF4D6D", size: 40px),
      Shape(form: hexagon, color: "#A78BFA", size: 40px),
      Shape(form: star, color: "#E9B44C", size: 40px),
      Shape(form: heart, color: "#FF4D6D", size: 40px),
      Shape(form: wave, color: "#4ECDC4", size: 40px),
    ]),
    Text("Tu as touché l'étoile {touches} fois."),
    Shape(name: Etoile, form: star, color: "#E9B44C", size: 72px),

    Hr(),
    Row(gap: 16px, align: between, children: [
      A("← Leçon 124 : une citation courte, le titre d'une œuvre", to: "124-une-citation-courte.holo"),
      A("Leçon 1 : une page →", to: "01-page.holo"),
    ]),
  ],

  rules: [
    On(Etoile.tap, effect: touches.add(1)),
    On(Ruche.hover, effect: vue.set(1)),
    On(Ruche.hoverEnd, effect: vue.set(0)),
  ],
)

Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 28px; }
A { color: #8fd3ff; }
Image { width: 120px; aspect-ratio: 1; }
.vague { width: 100%; aspect-ratio: 3/1; form: wave; }
.bandeau { color: #101020; font-size: 24px; }
.rond { form: circle; }
.ruche { form: hexagon; }
.etoile { form: star; }
.coeur { form: heart; }
