// Leçon 13 — Ce que la page retient
//
// Ce qu'on apprend :
//   « state: State(compte: 0) » déclare une valeur, compte, qui part de 0.
//   {compte} dans un texte l'affiche. Quand elle change, le texte suit tout seul.
//   Un bouton ne change rien lui-même : une règle fait une demande au moteur.
//   Les demandes : add (ajouter), sub (retirer), set (fixer). On ne descend pas sous 0.
//   Une règle peut faire plusieurs demandes : on les met entre crochets.
//
// À essayer :
//   Appuie sur les boutons. Écris {compt} sans e : le moteur refuse et dit pourquoi.
//
// (Les styles tout en bas servent à rendre la leçon lisible : voir la leçon 5.)

Page(
  title: "Leçon 13 : ce que la page retient",
  state: State(compte: 0, appuis: 0),
  children: [
    H1("Ce que la page retient"),
    Text("Le compte est à {compte}. Tu as appuyé {appuis} fois."),
    Row(gap: 8px, children: [
      Button(name: Plus, text: "+ 1"),
      Button(name: Moins, text: "- 1"),
      Button(name: Zero, text: "Remettre à zéro"),
    ]),

    Hr(),
    Row(gap: 16px, align: between, children: [
      A("← Leçon 12 : le carrefour et ses portails", to: "12-carrefour.holo"),
      A("Leçon 14 : des prix, un nombre d'articles, un total →", to: "14-prix.holo"),
    ]),
  ],
  rules: [
    On(Plus.tap, effect: [compte.add(1), appuis.add(1)]),
    On(Moins.tap, effect: [compte.sub(1), appuis.add(1)]),
    On(Zero.tap, effect: compte.set(0)),
  ],
)
Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 28px; }
A { color: #8fd3ff; }
