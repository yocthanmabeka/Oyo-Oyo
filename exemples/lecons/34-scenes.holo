// Leçon 34 — Des scènes qui s'enchaînent
//
// Ce qu'on apprend :
//   Scenes(...) est une petite scène de théâtre : les Scene(...) qu'elle contient passent
//   l'une après l'autre, au même endroit. Chacune dit combien de temps elle dure : for: 3s.
//   Dans une scène, le « at: » des mouvements compte depuis le début de la scène.
//   repeat: forever : tout recommence. Sans lui, la dernière scène reste.
//   each: 0.2s, sur un bloc qui a des enfants, les fait entrer l'un après l'autre.
//   Qui demande moins de mouvement à son téléphone voit seulement la dernière scène.
//
// À essayer :
//   Retire « repeat: forever » : à la fin, la dernière scène reste affichée.
//
// (Les styles tout en bas servent à rendre la leçon lisible : voir la leçon 5.)

Page(
  title: "Leçon 34 : des scènes",
  children: [
    Scenes(height: 220px, repeat: forever, children: [
      Scene(for: 2.5s, children: [
        H1("Un", enter: Enter(scale: 3, opacity: 0, blur: 12px, for: 0.6s)),
      ]),
      Scene(for: 2.5s, children: [
        H1("Deux", enter: Enter(x: -200px, opacity: 0, ease: back)),
      ]),
      Scene(for: 3s, children: [
        Row(gap: 12px, align: center, enter: Enter(y: 30px, opacity: 0, each: 0.2s, ease: spring), children: [
          Shape(form: circle, color: "#F472B6", size: 30px),
          Shape(form: circle, color: "#4ECDC4", size: 30px),
          Shape(form: circle, color: "#E9B44C", size: 30px),
        ]),
      ]),
    ]),

    Hr(),
    Row(gap: 16px, align: between, children: [
      A("← Leçon 33 : une boucle", to: "33-boucle.holo"),
      A("Leçon 35 : les repères →", to: "35-reperes.holo"),
    ]),
  ],
)

Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 28px; }
A { color: #8fd3ff; }
