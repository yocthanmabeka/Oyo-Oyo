// Leçon 110 — Un module qui dessine
//
// Ce qu'on apprend :
//   Drawing(…, shapes: fleur) : les formes d'un dessin peuvent venir d'une liste à champs, une
//   forme par élément : Item(form: "circle", x: 10, y: 20, r: 5, fill: "#E9B44C").
//   form vaut "rect", "circle", "line" ou "path" ; les autres champs sont ceux des formes écrites
//   (leçon 98), et x1, y1, x2, y2 pour les deux bouts d'un trait.
//   Un module enfermé (leçon 97) rend cette liste, comme n'importe quelle valeur : il « dessine »
//   sans jamais toucher au dessin du navigateur. Le moteur vérifie chaque forme avant de la
//   dessiner ; une forme fausse est laissée de côté.
//
// À essayer :
//   Choisis un nombre de pétales, puis « Dessiner la fleur ».
//
// Le module est écrit en Rust, dans modules/fleur.rs.
//
// (Les styles tout en bas servent à rendre la leçon lisible : voir la leçon 5.)

module "110-fleur.wasm"

Page(
  title: "Leçon 110 : un module qui dessine",
  state: State(petales: 6, fleur: []),
  modules: [
    Module(name: Fleur, source: "110-fleur.wasm", input: [petales], output: [fleur], time: 100ms, memory: 1MB),
  ],
  children: [
    H1("Un module qui dessine"),
    Drawing(label: "Une fleur, dessinée par un module", width: 320, height: 180, shapes: fleur, children: [
      Rect(x: 0, y: 0, width: 320, height: 180, radius: 12, fill: "#16213e"),
    ]),
    Slider(value: petales, label: "Pétales", min: 3, max: 12),
    Button(name: Dessiner, text: "Dessiner la fleur"),
    P("{fleur} formes dessinées."),

    Hr(),
    Row(gap: 16px, align: between, children: [
      A("← Leçon 101 : une valeur partagée", to: "101-une-valeur-partagee.holo"),
      A("Leçon 1 : une page →", to: "01-page.holo"),
    ]),
  ],
  rules: [
    On(Dessiner.tap, effect: Fleur.run),
  ],
)
Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 28px; }
A { color: #8fd3ff; }
