// Une page d'essai (moteur/outils/browser-tests.mjs), pas une leçon : une liste reçue du serveur.
// Le fichier de données est choisi par l'essai : « donnees-trop-grosses.json » est pris ; un fichier
// de plus de 64 Ko est refusé, et la liste garde sa valeur de départ.

Page(
  title: "Essai : des données trop grosses",
  state: State(articles: [ Item(title: "Au départ", price: 0) ]),
  data: Data(from: "donnees-trop-grosses.json"),
  children: [
    P("{articles} article(s)"),
    Repeat(over: articles, children: [ Text("{item.title}") ]),
  ],
)
