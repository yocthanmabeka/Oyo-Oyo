// Une boutique, écrite en HoloCode.
// La même boutique est écrite en HTML, CSS et JavaScript dans le dossier web/.
// Ce fichier emploie tout le vocabulaire actuel du langage.

// Les deux sortes d'import (cette boutique n'en a pas besoin) :
//   import "shelves.holo"        un autre fichier .holo (leçon 25)
//   module "physics.wasm"        un module WebAssembly, enfermé (leçon 69)
// Les ponts vers du JavaScript ou du CSS existants (bridge js, bridge css) sont refusés :
// ils feraient entrer du code sans garantie (ADR-011, partie B).

Page(
  name: Shop,
  title: "My shop",

  // Comment la page se regarde. Ce sont des garde-fous : le visiteur ne peut pas les dépasser.
  zoom: Zoom(
    active: true,     // false : le visiteur ne peut pas zoomer dans la page
    max: 1000000,     // on ne grossit pas la page plus d'un million de fois
    shrink: false,    // true : dézoomer réduit la page jusqu'à ce qu'elle soit un seul point
    levels: 8,        // au plus huit sites emboîtés les uns dans les autres
    speed: 1,         // la vitesse du zoom à la molette ; 2 : deux fois plus vite
  ),

  // Quand on zoome (Ctrl + molette, ou pincer), chaque pixel de la page devient un point.
  // Sans « points: », une page ne devient jamais des points : c'est un site ordinaire, quel que
  // soit le zoom. L'écrire active les points.
  points: Points(
    after: 4,         // jusqu'à un zoom × 4, la page reste un site ordinaire : on lit, on copie
                      // (jamais moins de 2 : on peut toujours doubler la taille du texte)
    size: 6px,        // un pixel devient un point lumineux quand il atteint cette taille
    fragment: 40px,   // un point se morcelle quand il atteint cette taille…
    grid: 4,          // …en une grille de 4 × 4…
    depth: 20,        // …et cela au plus vingt fois de suite
    density: 2,       // points par pixel d'écran, dans chaque sens
  ),

  // Tourner la page. Sans « tilt », une page ne tourne pas : c'est un site ordinaire, toujours
  // lisible. L'écrire active la rotation, et le bouton « Tourner » apparaît.
  // Quand on tourne la page, ce qui est lumineux se soulève au-dessus du fond.
  relief: Relief(
    height: 10px,     // la hauteur du relief
    tilt: 360deg,     // jusqu'où l'on peut tourner la page ; 360deg : on en fait le tour
  ),

  // Les valeurs de la page : ce qu'elle retient. Ici, combien de chaque tableau est dans le
  // panier. Tout part de zéro.
  // Une valeur est un nombre entier, ou un texte entre guillemets (buyer : le prénom de l'acheteur).
  state: State(sunrise: 0, blueDoor: 0, marketDay: 0, gift: 0, tip: 0, buyer: ""),

  // Les prix. Chacun porte le nom d'une valeur : c'est le prix de cet article. Dès qu'une page
  // donne des prix, le moteur calcule deux valeurs de plus, qu'on affiche comme les autres :
  // {count}, le nombre d'articles, et {total}, ce qu'ils coûtent. Aucun calcul à écrire.
  prices: Prices(sunrise: 120, blueDoor: 90, marketDay: 150),

  // Ce que la page garde d'une visite à l'autre, dans le navigateur du visiteur : on recharge
  // la page, le panier est encore là. Les autres valeurs repartent de leur départ.
  keep: [sunrise, blueDoor, marketDay, gift, tip, buyer],

  // Le carrefour : les portails vers les mondes voisins. Il s'ouvre quand on entre dans un
  // point, ou par le bouton « Carrefour ». Les sites écrits dans ce fichier passent d'abord ;
  // le reste est rempli par des mondes calculés.
  portals: Portals(
    layout: grid,     // grid (grille), row (ligne, on défile de gauche à droite),
                      // column (colonne, de haut en bas) ou diagonal
    count: 12,        // combien de mondes on montre
    size: 170px,      // la taille d'un portail
    brightness: 0.15, // la lumière du fond, de 0 à 1, pour y voir même sur un site sombre
    duration: 450ms,  // le temps que met un portail à s'ouvrir
  ),

  children: [
    // L'en-tête et le menu : des repères, pour qui navigue avec un lecteur d'écran. Posés
    // directement dans la page, ils sortent du contenu principal (ADR-036).
    Header(children: [
      Row(gap: 16px, align: between, children: [
        Text.note("Paintings by hand"),
        Nav(children: [
          Row(gap: 16px, children: [
            A("Home", to: "boutique.holo"),
            A("Source code", to: "https://github.com/yocthanmabeka/Metaverse"),
          ]),
        ]),
      ]),
    ]),

    H1("My shop"),

    // Une phrase seule est un paragraphe.
    "Paintings made by hand, one at a time.",

    // Le même paragraphe, écrit avec son bloc, pour lui poser un style nommé.
    P.card("Free delivery from **30 euros**."),

    H2("The paintings"),
    // « alt » dit ce que montre l'image, pour qui ne la voit pas.
    // Une pastille posée sur l'image : le premier enfant donne la taille, l'autre se pose
    // dessus, en haut à droite (ADR-036).
    Stack(children: [
      Image(source: "painting.svg", weight: 1KB, alt: "A painting: a yellow sun over green hills"),
      Text.badge("New", align: topRight),
    ]),
    List(children: [
      "Sunrise over the river",
      "The blue door",
      "Market day",
    ]),

    // Une grille : trois colonnes sur un grand écran, moins sur un téléphone, sans rien écrire
    // de plus. Dans chaque case, une colonne : les éléments l'un sous l'autre.
    Grid(columns: 3, gap: 12px, children: [
      Column.card(gap: 4px, align: center, children: [
        P("Sunrise over the river"),
        Text.note("120 euros · {sunrise} in your cart"),
        Row(gap: 8px, align: center, children: [ Button(name: LessSunrise, text: "-"), Button(name: AddSunrise, text: "+") ]),
      ]),
      Column.card(gap: 4px, align: center, children: [
        P("The blue door"),
        Text.note("90 euros · {blueDoor} in your cart"),
        Row(gap: 8px, align: center, children: [ Button(name: LessBlueDoor, text: "-"), Button(name: AddBlueDoor, text: "+") ]),
      ]),
      Column.card(gap: 4px, align: center, children: [
        P("Market day"),
        Text.note("150 euros · {marketDay} in your cart"),
        Row(gap: 8px, align: center, children: [ Button(name: LessMarketDay, text: "-"), Button(name: AddMarketDay, text: "+") ]),
      ]),
    ]),

    H3("Today"),
    // Un titre de niveau 4 : une partie de « Today ». Les titres vont jusqu'à H6.
    H4("Weekdays"),
    // Du texte sans rôle : une étiquette, une ligne d'état.
    Text.note("Open until 6 pm"),

    // Le panier. « {count} » et « {total} » sont calculés par le moteur ; le texte se met à
    // jour tout seul.
    H3("Your cart"),
    // Une ligne : côte à côte. Ce qui ne tient pas passe à la ligne.
    // align : start (au début), center (au milieu), end (à la fin), between (écartés).
    // Une condition : ce qu'elle contient ne se montre que si elle est vraie.
    // is (égal), not (différent), over (plus grand), under (plus petit).
    If(count, is: 0, children: [
      Text.note("Your cart is empty."),
    ]),
    If(count, over: 0, children: [
      Row(gap: 8px, align: between, children: [
        Text.note("{count} paintings · {total} euros"),
        Button(name: Empty, text: "Empty the cart"),
      ]),
    ]),
    // Deux comparaisons valent ensemble : au-dessus de 0 et en dessous de 300.
    If(total, over: 0, under: 300, children: [
      Text.note("Add more paintings: delivery is free from 300 euros."),
    ]),
    If(total, over: 299, children: [
      // Du texte montré tel quel, lettre pour lettre.
      Text.note("Delivery is free. Your code:"),
      Code("FREE-DELIVERY"),
    ]),

    If(count, over: 0, children: [
      // Une case à cocher : cochée, la valeur vaut 1 ; sinon 0.
      Checkbox(value: gift, label: "Gift wrap"),
      If(gift, is: 1, children: [
        Text.note("We will wrap your paintings."),
      ]),

      // Un champ où l'on écrit un nombre. « label » est obligatoire : c'est lui qui dit ce
      // qu'on attend, à l'œil comme à un lecteur d'écran. « max » borne ce qu'on peut écrire.
      Input(value: tip, label: "A tip for the painter, in euros", max: 50),
      If(tip, over: 0, children: [
        Text.note("Thank you for the {tip} euros."),
      ]),

      // Le même bloc présente un texte : le champ devient un champ de texte, et « max » borne
      // sa longueur. Un texte se montre comme un nombre, entre accolades. On peut demander
      // s'il est vide (is: "") ou rempli (not: "").
      Input(value: buyer, label: "Your first name", max: 20),
      If(buyer, not: "", children: [
        Text.note("This order is for {buyer}."),
      ]),
    ]),

    // Un trait de séparation, puis une citation.
    Hr(),
    Quote("The blue door has been in my kitchen for a year. I still stop to look at it.", by: "A customer"),

    Button.card(name: Open, text: "Enter the workshop"),

    // Un point : le pixel de l'Holoverse. Vu de loin, une lumière ;
    // quand on y entre, un monde.
    Point(
      name: Workshop,
      seed: 42,                          // la graine : le même nombre redonne le même monde
      brightness: 0.8,                   // de 0 à 1
      fragments: 6,                      // en combien de points il se morcelle
      color: "#E9B44C",                  // la couleur de ce point
      palette: ["#E9B44C", "#245C45"],   // les couleurs de ses enfants
      budget: 500KB,                     // ce que son contenu a le droit de peser

      inside: World(
        children: [
          H1("The workshop"),
          P("Here the paintings are made."),
          // Le panier vous suit dans le monde : c'est la même valeur.
          Text("{count} paintings in your cart · {total} euros"),
          Image(source: "easel.svg", weight: 1KB, alt: "An easel holding a blank canvas"),
          Button(name: Back, text: "Back to the shop"),

          // Un point dans un point : sans couleur imposée, la graine décide.
          Point(name: Storeroom, seed: 7),
        ],
        // Les règles d'un monde vivent dans ce monde.
        rules: [
          On(Back.tap, effect: Workshop.leave),
        ],
      ),
    ),

    // Le pied de page : un repère, lui aussi.
    Footer(children: [
      Hr(),
      Text.note("Made by hand · 2026"),
    ]),
  ],

  // Le bouton ne contient aucun code : une règle de la page relie
  // le signal (tap) à la capacité demandée (enter).
  rules: [
    On(Open.tap, effect: Workshop.enter),

    // Changer une valeur est une demande faite au moteur : add (ajouter), sub (retirer),
    // set (fixer). Le moteur décide : le panier ne descend jamais sous zéro.
    On(AddSunrise.tap, effect: sunrise.add(1)),
    On(LessSunrise.tap, effect: sunrise.sub(1)),
    On(AddBlueDoor.tap, effect: blueDoor.add(1)),
    On(LessBlueDoor.tap, effect: blueDoor.sub(1)),
    On(AddMarketDay.tap, effect: marketDay.add(1)),
    On(LessMarketDay.tap, effect: marketDay.sub(1)),
    // Vider le panier : une règle, trois demandes, entre crochets.
    On(Empty.tap, effect: [sunrise.set(0), blueDoor.set(0), marketDay.set(0)]),
  ],
)

// ---------------------------------------------------------------- les styles
// Ils s'écrivent comme en CSS. Un style vise un type de bloc ou un nom à point.

// Le thème : le style de la page, que son contenu reprend.
Page {
  background: #101020;
  color: white;
  font-family: Georgia, serif;
  padding: 24px 16px;
}

H1 { color: #E9B44C; font-size: 32px; font-weight: bold; text-align: center; margin: 0 0 16px 0; }
H2 { color: #E9B44C; font-size: 22px; }
H3 { font-size: 16px; font-style: italic; opacity: 0.8; }
H4 { font-size: 15px; color: silver; }

P { font-size: 16px; }

// Une taille fixe, plafonnée à la place disponible : sur un téléphone, l'image rétrécit.
Image { width: 480px; max-width: 100%; height: 180px; border-radius: 12px; }

A { color: #8fd3ff; }

.card {
  background: #1a1a2e;
  border: 1px solid #E9B44C;
  border-radius: 12px;
  padding: 8px 16px;
}

.note { font-size: 14px; color: silver; }

// Les boutons réagissent : au survol de la souris, au clavier (Tab), pendant l'appui (ADR-036).
Button {
  hover: { background: #2a2a4e; }
  focus: { border: 2px solid #E9B44C; }
  active: { opacity: 0.7; }
}

// La pastille posée sur l'image.
.badge { background: #E4572E; color: white; border-radius: 999px; padding: 2px 10px; font-size: 13px; font-weight: bold; }

// Les tailles de texte sont écrites en pixels ; le moteur les fait suivre le réglage « texte
// plus grand » du visiteur, et rétrécit le grand titre sur un téléphone (ADR-036).

// Le thème du monde où l'on entre.
World { background: black; color: white; text-align: center; }
