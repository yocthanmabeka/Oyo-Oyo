Page(
  title: "Catalogue : 200 produits", lang: "fr", description: "Deux cents produits à chercher, filtrer et parcourir.",
  state: State(search: "", chosen: "", offset: 0, end: 20, products: [Item(id: "", title: "", kind: "", price: 0)]),
  data: Data(from: "catalogue.json"),
  computed: [Filter(name: found, from: products, contains: search, in: [title], field: kind, is: chosen, sortBy: price, offset: offset, limit: 20, total: matching)],
  children: [
    Header(children: [Nav(children: [A("Accueil des parcours", to: "index.holo"), A("Fiche et panier", to: "fiche.holo")])]),
    H1("Catalogue de 200 produits"),
    Input(value: search, label: "Chercher un produit"),
    Choice(value: chosen, label: "Catégorie", menu: true, options: ["livre", "image"]),
    Button(name: Apply, text: "Revenir au début des résultats"),
    Button(name: All, text: "Toutes les catégories"),
    P("{found} produits affichés sur {matching}. Prix croissants."),
    Repeat(over: found, key: id, empty: "Aucun produit sur cette page.", children: [
      Column.card(gap: 8px, children: [H2("{item.title}"), P("{item.kind} · {item.price:cents} € HT")]),
    ]),
    Row(gap: 12px, children: [
      If(offset, over: 0, children: [Button(name: Previous, text: "Page précédente")]),
      If(end, under: matching, children: [Button(name: Next, text: "Page suivante")]),
    ]),
  ],
  rules: [
    On(Next.tap, effect: [offset.add(20), end.add(20)]),
    On(Previous.tap, effect: [offset.sub(20), end.sub(20)]),
    On(Apply.tap, effect: [offset.set(0), end.set(20)]),
    On(All.tap, effect: [chosen.set(""), search.set(""), offset.set(0), end.set(20)]),
  ],
)
Page { background: #101020; color: white; font-family: Georgia, serif; padding: 24px 16px; computer: { max-width: 960px; } print: { background: white; color: black; } }
H1 { color: #E9B44C; font-size: 28px; print: { color: black; } }
H2 { color: #E9B44C; font-size: 22px; print: { color: black; } }
A { color: #8fd3ff; print: { color: black; } }
.card { background: #22223a; padding: 16px; border-radius: 8px; }
Nav { print: { display: none; } }
