// Le showreel de Claude, en HoloCode.
//
// Sept scènes qui recommencent sans fin. Tout le mouvement est écrit ici : aucune ligne de
// JavaScript, aucune bibliothèque. Le moteur en fait du CSS ; la page bouge même avant que
// le moteur arrive dans le navigateur (ADR-033, ADR-034).
//
// Son jumeau en HTML, CSS et JavaScript : ../web/showreel.html

Page(
  title: "Claude — Motion Showreel",

  children: [
    Scenes(height: 640px, repeat: forever, children: [

      // 1. Le Big Bang : un point lumineux bat, puis éclate en mondes.
      Scene(for: 4.5s, children: [
        Board(height: 360px, children: [
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 96, y: 50,
          enter: Enter(x: -270px, y: 0px, scale: 0, opacity: 0, at: 1.400s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 83, y: 58,
          enter: Enter(x: -195px, y: -27px, scale: 0, opacity: 0, at: 1.415s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 69, y: 60,
          enter: Enter(x: -115px, y: -34px, scale: 0, opacity: 0, at: 1.430s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 90, y: 73,
          enter: Enter(x: -233px, y: -74px, scale: 0, opacity: 0, at: 1.445s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 74, y: 74,
          enter: Enter(x: -144px, y: -77px, scale: 0, opacity: 0, at: 1.460s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 62, y: 69,
          enter: Enter(x: -69px, y: -61px, scale: 0, opacity: 0, at: 1.475s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 73, y: 90,
          enter: Enter(x: -135px, y: -129px, scale: 0, opacity: 0, at: 1.490s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 59, y: 83,
          enter: Enter(x: -55px, y: -107px, scale: 0, opacity: 0, at: 1.505s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 51, y: 72,
          enter: Enter(x: -5px, y: -72px, scale: 0, opacity: 0, at: 1.520s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 50, y: 96,
          enter: Enter(x: 0px, y: -149px, scale: 0, opacity: 0, at: 1.400s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 42, y: 83,
          enter: Enter(x: 49px, y: -108px, scale: 0, opacity: 0, at: 1.415s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 40, y: 69,
          enter: Enter(x: 61px, y: -64px, scale: 0, opacity: 0, at: 1.430s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 27, y: 90,
          enter: Enter(x: 135px, y: -129px, scale: 0, opacity: 0, at: 1.445s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 26, y: 74,
          enter: Enter(x: 139px, y: -80px, scale: 0, opacity: 0, at: 1.460s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 31, y: 62,
          enter: Enter(x: 110px, y: -38px, scale: 0, opacity: 0, at: 1.475s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 10, y: 73,
          enter: Enter(x: 233px, y: -74px, scale: 0, opacity: 0, at: 1.490s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 17, y: 59,
          enter: Enter(x: 193px, y: -31px, scale: 0, opacity: 0, at: 1.505s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 28, y: 51,
          enter: Enter(x: 130px, y: -3px, scale: 0, opacity: 0, at: 1.520s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 4, y: 50,
          enter: Enter(x: 270px, y: 0px, scale: 0, opacity: 0, at: 1.400s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 17, y: 42,
          enter: Enter(x: 195px, y: 27px, scale: 0, opacity: 0, at: 1.415s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 31, y: 40,
          enter: Enter(x: 115px, y: 34px, scale: 0, opacity: 0, at: 1.430s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 10, y: 27,
          enter: Enter(x: 233px, y: 74px, scale: 0, opacity: 0, at: 1.445s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 26, y: 26,
          enter: Enter(x: 144px, y: 77px, scale: 0, opacity: 0, at: 1.460s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 38, y: 31,
          enter: Enter(x: 69px, y: 61px, scale: 0, opacity: 0, at: 1.475s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 27, y: 10,
          enter: Enter(x: 135px, y: 129px, scale: 0, opacity: 0, at: 1.490s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 41, y: 17,
          enter: Enter(x: 55px, y: 107px, scale: 0, opacity: 0, at: 1.505s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 49, y: 28,
          enter: Enter(x: 5px, y: 72px, scale: 0, opacity: 0, at: 1.520s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 50, y: 4,
          enter: Enter(x: 0px, y: 149px, scale: 0, opacity: 0, at: 1.400s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 58, y: 17,
          enter: Enter(x: -49px, y: 108px, scale: 0, opacity: 0, at: 1.415s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 60, y: 31,
          enter: Enter(x: -61px, y: 64px, scale: 0, opacity: 0, at: 1.430s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: diamond, color: "#E9B44C", size: 14px, x: 73, y: 10,
          enter: Enter(x: -135px, y: 129px, scale: 0, opacity: 0, at: 1.445s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#FF6B6B", size: 10px, x: 74, y: 26,
          enter: Enter(x: -139px, y: 80px, scale: 0, opacity: 0, at: 1.460s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
        Shape(form: circle, color: "#4ECDC4", size: 8px, x: 69, y: 38,
          enter: Enter(x: -110px, y: 38px, scale: 0, opacity: 0, at: 1.475s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.50s)),
        Shape(form: diamond, color: "#A78BFA", size: 14px, x: 90, y: 27,
          enter: Enter(x: -233px, y: 74px, scale: 0, opacity: 0, at: 1.490s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.65s)),
        Shape(form: circle, color: "#F472B6", size: 10px, x: 83, y: 41,
          enter: Enter(x: -193px, y: 31px, scale: 0, opacity: 0, at: 1.505s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.80s)),
        Shape(form: circle, color: "#60A5FA", size: 8px, x: 72, y: 49,
          enter: Enter(x: -130px, y: 3px, scale: 0, opacity: 0, at: 1.520s, for: 1.1s, ease: out),
          loop: Loop(scale: 1.6, for: 0.95s)),
          Point(name: Core, color: "#FFE9A8", x: 50, y: 50,
            enter: Enter(scale: 0, opacity: 0, for: 0.9s, ease: back),
            loop: Loop(scale: 1.5, for: 0.35s)),
        ]),
        Text.legend("Tout commence par un point.",
          enter: Enter(y: 16px, opacity: 0, blur: 6px, at: 2.2s, for: 0.9s)),
      ]),

      // 2. Le titre : chaque lettre arrive sur un ressort.
      Scene(for: 4s, children: [
        H1.title("CLAUDE",
          enter: Enter(y: 80px, rotate: -25deg, opacity: 0, blur: 12px, letters: 0.07s, for: 1.1s, ease: spring)),
        Hr(enter: Enter(scale: 0, at: 0.8s, for: 1s, ease: smooth)),
        H2.role("Motion designer",
          enter: Enter(y: 24px, opacity: 0, letters: 0.025s, at: 1.1s, for: 0.6s, ease: out)),
      ]),

      // 3. Typographie cinétique : trois mots, trois façons d'entrer.
      Scene(for: 4.5s, children: [
        H1.word("Penser.", enter: Enter(scale: 3, opacity: 0, blur: 20px, for: 0.6s, ease: out)),
        H1.word2("Concevoir.", enter: Enter(x: -500px, opacity: 0, at: 0.9s, for: 0.8s, ease: back)),
        H1.word3("Animer.", enter: Enter(flip: 90deg, opacity: 0, letters: 0.05s, at: 1.8s, for: 0.7s, ease: back),
          loop: Loop(hue: 300deg, for: 2.5s)),
      ]),

      // 4. Morphing : un carré devient un rond, tourne, change de couleur.
      Scene(for: 4.5s, children: [
        Row(gap: 40px, align: center, children: [
          Shape(form: square, color: "#E9B44C", size: 110px,
            enter: Enter(scale: 0, rotate: -180deg, for: 0.9s, ease: back),
            loop: Loop(round: 50, rotate: 180deg, hue: 140deg, for: 1.2s, ease: smooth)),
          Shape(form: square, color: "#4ECDC4", size: 110px,
            enter: Enter(scale: 0, rotate: 180deg, at: 0.15s, for: 0.9s, ease: back),
            loop: Loop(round: 50, scale: 0.6, for: 0.9s, ease: smooth)),
          Shape(form: square, color: "#F472B6", size: 110px,
            enter: Enter(scale: 0, rotate: -180deg, at: 0.3s, for: 0.9s, ease: back),
            loop: Loop(round: 50, rotate: -270deg, hue: -120deg, for: 1.5s, ease: smooth)),
        ]),
        Text.legend("Squash, stretch, morph.", enter: Enter(opacity: 0, y: 12px, at: 0.9s)),
      ]),

      // 5. Le laboratoire des courbes : le même trajet, quatre caractères.
      Scene(for: 5s, children: [
        Column(gap: 14px, align: start, children: [
          Row(gap: 16px, align: center, children: [
            Text.label("linear"),
            Shape(form: circle, color: "#60A5FA", size: 28px, enter: Enter(x: -260px, at: 0.3s, for: 1.6s, ease: linear)),
          ]),
          Row(gap: 16px, align: center, children: [
            Text.label("smooth"),
            Shape(form: circle, color: "#A78BFA", size: 28px, enter: Enter(x: -260px, at: 0.3s, for: 1.6s, ease: smooth)),
          ]),
          Row(gap: 16px, align: center, children: [
            Text.label("back"),
            Shape(form: circle, color: "#F472B6", size: 28px, enter: Enter(x: -260px, at: 0.3s, for: 1.6s, ease: back)),
          ]),
          Row(gap: 16px, align: center, children: [
            Text.label("spring"),
            Shape(form: circle, color: "#E9B44C", size: 28px, enter: Enter(x: -260px, at: 0.3s, for: 1.6s, ease: spring)),
          ]),
          Row(gap: 16px, align: center, children: [
            Text.label("bounce"),
            Shape(form: circle, color: "#4ECDC4", size: 28px, enter: Enter(y: -120px, at: 0.3s, for: 1.6s, ease: bounce)),
          ]),
        ]),
        Text.legend("Le mouvement a un caractère.", enter: Enter(opacity: 0, at: 2.2s)),
      ]),

      // 6. La profondeur : des cartes qui se retournent, l'une après l'autre.
      Scene(for: 4.5s, children: [
        Row(gap: 18px, align: center, enter: Enter(flip: -100deg, opacity: 0, each: 0.18s, for: 0.9s, ease: back), children: [
          Text.card("Rust"),
          Text.card("WebGPU"),
          Text.card("HoloCode"),
          Text.card("Big Bang"),
        ]),
        Shape(form: diamond, color: "#A78BFA", size: 70px,
          enter: Enter(scale: 0, at: 1s, ease: spring),
          loop: Loop(tilt: 180deg, flip: 180deg, for: 1.6s, back: false, ease: linear)),
      ]),

      // 7. La fin : la signature.
      Scene(for: 4.5s, children: [
        H1.title("Holoverse", enter: Enter(scale: 0.4, opacity: 0, blur: 16px, letters: 0.06s, for: 0.9s, ease: back)),
        Text.legend("Fait en HoloCode · 0 ligne de JavaScript",
          enter: Enter(y: 20px, opacity: 0, at: 0.9s, for: 0.7s)),
        Text.hire("Engagez-moi.",
          enter: Enter(scale: 0, opacity: 0, at: 1.6s, for: 0.8s, ease: spring),
          loop: Loop(scale: 1.08, for: 0.6s)),
      ]),
    ]),
  ],
)

Page { background: #05050c; color: white; font-family: "Inter", system-ui, sans-serif; padding: 0; }
.title { font-size: 96px; font-weight: bold; color: #FFE9A8; margin: 0; }
.role { font-size: 26px; font-weight: normal; color: #9aa4c7; margin: 0; }
.word { font-size: 72px; font-weight: bold; color: white; margin: 0; }
.word2 { font-size: 72px; font-weight: bold; color: #4ECDC4; margin: 0; }
.word3 { font-size: 72px; font-weight: bold; color: #F472B6; margin: 0; }
.legend { font-size: 20px; color: #9aa4c7; }
.label { font-family: ui-monospace, Consolas, monospace; font-size: 15px; color: #9aa4c7; width: 80px; }
.card { background: #141428; border: 1px solid #E9B44C; border-radius: 14px; padding: 22px 26px; font-size: 20px; font-weight: bold; }
.hire { font-size: 34px; font-weight: bold; color: #05050c; background: #E9B44C; border-radius: 40px; padding: 12px 34px; }
Hr { width: 320px; color: #E9B44C; }
