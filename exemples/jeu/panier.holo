// Un deuxième jeu, toujours sans une ligne de code : une pomme tombe, on la rattrape avec un
// panier qu'on déplace au clavier (flèches gauche et droite) ou avec deux boutons.
//
// Ce fichier montre le clavier (Key), ce qui bouge tout seul (Every), les règles qui guettent
// (When) et la rencontre de deux objets (Meet).

Page(
  name: Orchard,
  title: "Catch the apple",

  state: State(
    lives: 0,       // les pommes qu'on peut encore laisser tomber ; 0 : pas de partie en cours
    score: 0,
    basket: 50,     // où est le panier, de 0 (à gauche) à 100 (à droite)
    apple_x: 50,    // où est la pomme
    apple_y: 0,     // de 0 (en haut) à 100 (en bas)
  ),

  children: [
    H1("Catch the apple"),

    If(lives, is: 0, children: [
      "An apple falls. Move the basket under it: arrow keys, or the two buttons.",
      If(score, over: 0, children: [
        P.result("Three apples lost. Your score: **{score}**"),
      ]),
      Button.play(name: Play, text: "Play"),
    ]),

    If(lives, over: 0, children: [
      Row(align: between, children: [
        Text("Score: {score}"),
        Text("Lives: {lives}"),
      ]),

      // Sur un plateau, une valeur qui sert de place reste entre 0 et 100 : le panier ne sort
      // jamais, même si l'on insiste sur la flèche.
      Board(height: 360px, children: [
        Point(name: Apple, seed: 3, color: "#E4572E", x: apple_x, y: apple_y),
        Point(name: Basket, seed: 9, color: "#E9B44C", x: basket, y: 96),
      ]),

      // Pour le téléphone : deux boutons font ce que font les flèches.
      Row(align: between, children: [
        Button.move(name: Left, text: "◀"),
        Button.move(name: Right, text: "▶"),
      ]),
    ]),
  ],

  rules: [
    // Commencer.
    On(Play.tap, effect: score.set(0)),
    On(Play.tap, effect: lives.set(3)),
    On(Play.tap, effect: apple_y.set(0)),

    // Le clavier : « Key » est le clavier du visiteur. Signaux : left, right, up, down, space.
    On(Key.left, effect: basket.sub(8)),
    On(Key.right, effect: basket.add(8)),
    On(Left.tap, effect: basket.sub(8)),
    On(Right.tap, effect: basket.add(8)),

    // La pomme tombe : dix fois par seconde, elle descend un peu.
    Every(100ms, effect: apple_y.add(3)),

    // Une rencontre : quand le panier et la pomme se touchent, un point de plus, et une
    // nouvelle pomme part d'en haut, à une place tirée au hasard.
    Meet(Basket, Apple, within: 9, effect: score.add(1)),
    Meet(Basket, Apple, within: 9, effect: apple_x.random(100)),
    Meet(Basket, Apple, within: 9, effect: apple_y.set(0)),

    // Une règle qui guette : au moment où la pomme arrive tout en bas sans avoir été
    // rattrapée, une vie de moins, et une nouvelle pomme.
    When(apple_y, over: 99, effect: lives.sub(1)),
    When(apple_y, over: 99, effect: apple_x.random(100)),
    When(apple_y, over: 99, effect: apple_y.set(0)),
  ],
)

Page { background: #0d1a12; color: white; font-family: Georgia, serif; padding: 24px 16px; }
H1 { color: #E9B44C; font-size: 30px; text-align: center; }
Board { background: #14261b; border: 1px solid #E9B44C; border-radius: 16px; }
.play { background: #E9B44C; color: #0d1a12; font-size: 18px; font-weight: bold; padding: 10px 28px; border-radius: 999px; }
.move { font-size: 22px; padding: 10px 28px; border-radius: 12px; }
.result { font-size: 18px; text-align: center; }
