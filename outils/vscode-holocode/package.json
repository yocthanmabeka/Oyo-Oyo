{
  "name": "holocode",
  "displayName": "HoloCode",
  "description": "Reconnaît les fichiers .holo : couleurs du langage, la faute soulignée et corrigée d'un clic, les mots proposés, et un bouton pour ouvrir le fichier dans le navigateur.",
  "version": "0.2.0",
  "publisher": "holoverse",
  "license": "UNLICENSED",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:holo"],
  "contributes": {
    "languages": [
      {
        "id": "holo",
        "aliases": ["HoloCode", "holo"],
        "extensions": [".holo"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      { "language": "holo", "scopeName": "source.holo", "path": "./syntaxes/holo.tmLanguage.json" }
    ],
    "commands": [
      { "command": "holocode.open", "title": "HoloCode : ouvrir dans le navigateur", "icon": "$(play)" }
    ],
    "menus": {
      "editor/title": [
        { "command": "holocode.open", "when": "resourceLangId == holo", "group": "navigation" }
      ],
      "explorer/context": [
        { "command": "holocode.open", "when": "resourceExtname == .holo", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "holocode.open", "key": "ctrl+alt+h", "when": "editorLangId == holo" }
    ],
    "configuration": {
      "title": "HoloCode",
      "properties": {
        "holocode.server": {
          "type": "string",
          "default": "http://localhost:8080",
          "description": "Adresse du serveur local du moteur (node moteur/outils/server.mjs)."
        }
      }
    }
  }
}
